{
	"name": "electrobun-nomen",
	"version": "0.1.0",
	"description": "Nomen is a file manager with metadata superpowers",
	"scripts": {
		"postinstall": "bunx bun2nix -o bun.nix",
		"build": "bun run build.ts && electrobun build",
		"start": "bun run build.ts && electrobun dev",
		"dev": "electrobun dev --watch",
		"build:canary": "bun run build.ts && electrobun build --env=canary",
		"test": "bun test"
	},
	"dependencies": {
		"@tursodatabase/database": "^0.5.2",
		"electrobun": "1.16.0",
		"react": "^18.3.1",
		"react-dom": "^18.3.1"
	},
	"devDependencies": {
		"@types/bun": "latest",
		"@types/react": "^18.3.12",
		"@types/react-dom": "^18.3.1",
		"bun2nix": "latest",
		"typescript": "^5.7.2"
	}
}
