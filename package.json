{
	"name": "electrobun-nomen",
	"version": "0.1.0",
	"description": "Nomen is a file manager with metadata superpowers",
	"scripts": {
		"postinstall": "bunx bun2nix -o bun.nix",
		"build": "vite build && electrobun build",
		"start": "vite build && electrobun dev",
		"dev": "electrobun dev --watch",
		"dev:hmr": "concurrently \"bun run hmr\" \"bun run start\"",
		"hmr": "vite --port 5173",
		"build:canary": "vite build && electrobun build --env=canary",
		"test": "bun test"
	},
	"dependencies": {
		"@tursodatabase/database": "^0.5.2",
		"electrobun": "1.16.0",
		"react": "^18.3.1",
		"react-dom": "^18.3.1"
	},
	"devDependencies": {
		"@types/bun": "latest",
		"@types/react": "^18.3.12",
		"@types/react-dom": "^18.3.1",
		"@vitejs/plugin-react": "^4.3.4",
		"autoprefixer": "^10.4.20",
		"bun2nix": "latest",
		"concurrently": "^9.1.0",
		"postcss": "^8.4.49",
		"typescript": "^5.7.2",
		"vite": "^6.0.3"
	}
}
